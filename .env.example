# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# kie.ai key — powers nano-banana-2 image-to-image. The same key already sits in
# gop-tarot-bot\.env if you want to reuse it.
KIE_API_KEY=

# Obsidian folder holding BOYS/, GIRLS/ and IMAGES/. Leave empty for the default
# path under the mavault vault.
VAULT_DIR=

# Admin panel port. 8765 is taken by bydlo-bot, so this one sits next to it.
ADMIN_PORT=8766
